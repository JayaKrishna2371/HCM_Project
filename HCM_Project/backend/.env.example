# =========================================================
#  HCM Backend — local environment configuration
#  Copy this file to ".env" and fill in the Azure AD values.
# =========================================================

# ----- App -----
APP_NAME=HCM Platform API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# ----- CORS (Angular dev server) -----
BACKEND_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ----- Azure AD (Entra ID) -----
# From Azure Portal -> App registration -> Overview
AZURE_TENANT_ID=fc388343-6a22-4b5b-a32f-a6aa2320b0fb
AZURE_CLIENT_ID=b643e0ac-2602-4281-8da2-1eaec09adc23

# The "Application ID URI" you set under "Expose an API".
# Typically: api://<AZURE_CLIENT_ID>
AZURE_API_AUDIENCE=api://b643e0ac-2602-4281-8da2-1eaec09adc23

# Algorithms Entra signs with
AZURE_JWT_ALGORITHMS=RS256

# ----- PostgreSQL (local) -----
DATABASE_URL=postgresql+psycopg://postgres:Allam2588%40@localhost:5432/hcm_db

# ----- Session -----
JWT_LEEWAY_SECONDS=30
