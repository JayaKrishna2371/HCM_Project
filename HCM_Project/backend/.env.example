# =========================================================
#  HCM Backend — local environment configuration
#  Copy this file to ".env" and fill in the values below.
# =========================================================

# ----- App -----
APP_NAME=HCM Platform API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# ----- CORS (Angular dev server) -----
BACKEND_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# =========================================================
#  Active Directory / LDAP  (ASK YOUR TEAM LEAD — see LDAP_SETUP.md)
# =========================================================
# One or more domain controllers. Prefer ldaps:// (TLS on 636).
LDAP_SERVER_URIS=ldaps://dc1.corp.example.com:636

# StartTLS on a plain ldap:// connection (ignored when using ldaps://).
LDAP_START_TLS=false
# Verify the DC certificate. Set false ONLY in a throwaway lab with self-signed certs.
LDAP_TLS_VALIDATE=true
# Optional CA bundle (PEM) that signed the DC cert.
# LDAP_CA_CERTS_FILE=/etc/ssl/certs/corp-ca.pem

LDAP_CONNECT_TIMEOUT=8

# ----- Service / bind account (recommended: search-then-bind) -----
# Read-only account used to look users up before verifying their password.
# Leave LDAP_BIND_DN empty to use direct-bind mode instead.
LDAP_BIND_DN=CN=svc-hcm,OU=Service Accounts,DC=corp,DC=example,DC=com
LDAP_BIND_PASSWORD=change-me

# Where users live and how to find one. {username} is substituted (escaped).
LDAP_USER_SEARCH_BASE=OU=Users,DC=corp,DC=example,DC=com
# Match the typed login against sAMAccountName (use a wider filter to also allow
# email/UPN logins, e.g.:
#   (&(objectClass=user)(|(sAMAccountName={username})(userPrincipalName={username})(mail={username})))
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})

# ----- Direct-bind mode (only used when LDAP_BIND_DN is empty) -----
# Bare usernames become "<username>@LDAP_DEFAULT_DOMAIN" for the bind.
LDAP_DEFAULT_DOMAIN=corp.example.com

# ----- Directory attribute names (defaults suit Microsoft AD) -----
LDAP_ATTR_GUID=objectGUID
LDAP_ATTR_USERNAME=sAMAccountName
LDAP_ATTR_UPN=userPrincipalName
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ATTR_GIVEN_NAME=givenName
LDAP_ATTR_SURNAME=sn
LDAP_ATTR_MEMBER_OF=memberOf

# ----- AD group -> application role mapping (JSON; CN or full DN, case-insensitive) -----
LDAP_ROLE_MAPPINGS={"HCM-Admins":"Admin","HCM-Operators":"Operator","HCM-Viewers":"Viewer"}
# Role used when none of the user's groups match a mapping above.
LDAP_DEFAULT_ROLE=Viewer

# =========================================================
#  JWT — tokens THIS API issues after a successful LDAP bind
# =========================================================
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=hcm-platform-api
JWT_AUDIENCE=hcm-platform
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_LEEWAY_SECONDS=30

# ----- PostgreSQL (local) -----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hcm_db
