# =========================================================
#  HCM Backend — local environment configuration
# =========================================================

# ----- App -----
APP_NAME=HCM Platform API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# ----- CORS (Angular dev server) -----
BACKEND_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# =========================================================
#  Active Directory / LDAP   <-- FILL THESE IN FROM YOUR TEAM LEAD
#  (see backend/LDAP_SETUP.md for exactly what to ask for)
# =========================================================
# Plain LDAP on 389 (no TLS). NOTE: the password is sent in cleartext on 389 —
# fine for a local test, switch to ldaps://...:636 before production.
LDAP_SERVER_URIS=ldap://REPLACE-AD-HOST:389
LDAP_START_TLS=false
LDAP_TLS_VALIDATE=false
# LDAP_CA_CERTS_FILE=
LDAP_CONNECT_TIMEOUT=8

# Direct-bind mode: LDAP_BIND_DN empty => the app binds straight as the end user
# (username@LDAP_DEFAULT_DOMAIN). No service account needed.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# Left empty: the app derives the search base from the domain in the UPN the
# user types (jdoe@corp.local -> DC=corp,DC=local). Set an explicit base only if
# your users live under a specific OU you want to scope the search to.
LDAP_USER_SEARCH_BASE=
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})

# (No default domain by design — users type their full UPN, e.g. user@domain.)

# Directory attribute names (AD defaults — usually no change needed)
LDAP_ATTR_GUID=objectGUID
LDAP_ATTR_USERNAME=sAMAccountName
LDAP_ATTR_UPN=userPrincipalName
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ATTR_GIVEN_NAME=givenName
LDAP_ATTR_SURNAME=sn
LDAP_ATTR_MEMBER_OF=memberOf

# No AD groups yet — leave mappings empty. Every authenticated user gets
# LDAP_DEFAULT_ROLE. Add mappings here later when you create groups.
LDAP_ROLE_MAPPINGS={}
LDAP_DEFAULT_ROLE=Viewer

# =========================================================
#  JWT — tokens this API issues after a successful LDAP bind
# =========================================================
JWT_SECRET_KEY=e9631a366a3e044196fc88b6cf1ebc05c98ff75310f9d96fc4ea7333cd46d49e
JWT_ALGORITHM=HS256
JWT_ISSUER=hcm-platform-api
JWT_AUDIENCE=hcm-platform
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_LEEWAY_SECONDS=30

# =========================================================
#  Multi-tenancy / RBAC
# =========================================================
DEFAULT_TENANT_CODE=HCAP
DEFAULT_TENANT_NAME=HCAP
AUTH_REQUIRE_DB_PROVISIONING=false
DEFAULT_USER_ROLE=USER
TENANT_HEADER=X-Tenant-Id

# Bootstrap super admin (seeded on startup if none exists). Set to the login you
# will authenticate with; the placeholder directory_id is rebound on first login.
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@platform.local
SUPER_ADMIN_NAME=Platform Super Admin

# ----- PostgreSQL (local) -----
# Switched to the previously-empty saas_platform DB: the stale hcm_db schema
# (Azure-era users + experimental tenant tables) was incompatible with the
# current code. hcm_db is left untouched.
DATABASE_URL=postgresql+psycopg://postgres:Allam2588%40@localhost:5432/saas_platform
